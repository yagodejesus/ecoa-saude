# ────────────────────────────────────────────────────────
# VERIFACTS - CONFIGURAÇÃO DE AMBIENTE
# ────────────────────────────────────────────────────────

# SERVIDOR
PORT=3000

# OLLAMA (Local LLM para análise)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3

# GOOGLE FACT CHECK API
GOOGLE_FACTCHECK_API_KEY=sua-chave-aqui

# HUGGING FACE API (Detecção de IA)
# Obter em: https://huggingface.co/settings/tokens
# Modelo usado: Organika/sdxl-detector (80-95% acertividade)
HUGGINGFACE_API_KEY=hf_suachaveaqui

# DIRETÓRIO TEMPORÁRIO
TEMP_DIR=./tmp

# WHISPER (Transcrição de áudio em vídeos)
WHISPER_COMMAND=/path/to/whisper
WHISPER_MODEL=base

# CONFIGURAÇÕES DE ANÁLISE
MAX_SCRAPED_CHARS=5000
MAX_VIDEO_FRAMES=6
FRAME_INTERVAL_SECONDS=8
MAX_NEWS_ITEMS=15
NEWS_LOOKBACK_DAYS=90
